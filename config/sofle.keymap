#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // default: 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

/ {
    // Activate ADJUST layer by pressing raise and lower

    conditional_layers {
        compatible = "zmk,conditional-layers";

        win_lower {
            if-layers = <3 1>;
            then-layer = <4>;
        };

        mac_lower {
            if-layers = <3 2>;
            then-layer = <5>;
        };

        last_layer {
            if-layers = <3 6>;
            then-layer = <9>;
        };

        win_raise {
            if-layers = <1 6>;
            then-layer = <7>;
        };

        mac_raise {
            if-layers = <2 6>;
            then-layer = <8>;
        };
    };

    combos { compatible = "zmk,combos"; };

    macros {
        kb_win: kb_mod {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0 &to 1>;
            label = "KB_MOD";
        };

        kb_mac: kb_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1 &to 2>;
            label = "KB_MAC";
        };

        clear_mods: clear_mods {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0>;
            label = "CLEAR_MODS";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "default";

            // ------------------------------------------------------------------------------------------------------------
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   =   |
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   [   |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   ]   |
            // | LCTRL |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  |       |  N   |  M    |  ,    |  .   |   /   |   '   |
            //               | GUI | DEL  |LSHIFT| LOWER|  ENTER |  | SPACE | RAISE|BACKSPC| ALT   | GUI  |

            bindings = <
&kp ESC         &kp N1  &kp N2        &kp N3    &kp N4    &kp N5                           &kp N6  &kp N7         &kp N8     &kp N9    &kp N0    &kp MINUS
&kp TAB         &kp Q   &kp W         &kp E     &kp R     &kp T                            &kp Y   &kp U          &kp I      &kp O     &kp P     &kp LEFT_BRACKET
&kp LEFT_SHIFT  &kp A   &kp S         &kp D     &kp F     &kp G                            &kp H   &kp J          &kp K      &kp L     &kp SEMI  &kp SQT
&kp LCTRL       &kp Z   &kp X         &kp C     &kp V     &kp B   &mo 9        &kp C_MUTE  &kp N   &kp M          &kp COMMA  &kp DOT   &kp FSLH  &kp RBKT
                        &kp LEFT_ALT  &kp CLCK  &kp LGUI  &mo 3   &kp SPACE    &kp RET     &mo 6   &kp BACKSPACE  &kp DEL    &kp RGUI
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp PG_UP PG_DN>;
        };

        on_win {
            bindings = <
&trans        &trans  &trans    &trans  &trans     &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans        &trans  &trans    &trans  &trans     &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans        &trans  &trans    &trans  &trans     &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&kp LEFT_ALT  &trans  &trans    &trans  &trans     &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                      &kp LWIN  &trans  &kp LCTRL  &trans  &trans    &trans  &trans  &trans  &trans  &trans
            >;
        };

        on_mac {
            bindings = <
&trans  &trans  &trans    &trans  &trans        &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans    &trans  &trans        &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans    &trans  &trans        &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans    &trans  &trans        &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &kp LALT  &trans  &kp LEFT_WIN  &trans  &trans    &trans  &trans  &trans  &trans  &trans
            >;
        };

        base_lower {
            display-name = "lower";
            bindings = <
&trans      &kp F1     &kp F2             &kp F3     &kp F4         &kp F5                          &kp F6       &kp F7      &kp F8     &kp F9                &kp F10                &kp F11
&caps_word  &kp EXCL   &kp AT_SIGN        &kp POUND  &kp DOLLAR     &kp PRCNT                       &kp CARET    &kp AMPS    &kp STAR   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp F12
&trans      &kp GRAVE  &kp DOUBLE_QUOTES  &kp POUND  &kp SEMICOLON  &kp KP_EQUAL                    &kp KP_PLUS  &kp QMARK   &kp PIPE   &kp LBRC              &kp RBRC               &kp PIPE
&trans      &trans     &trans             &trans     &trans         &trans        &trans    &trans  &kp TILDE    &kp KP_DOT  &kp COMMA  &kp LBKT              &kp RBKT               &trans
                       &trans             &trans     &trans         &trans        &trans    &trans  &trans       &trans      &trans     &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp PG_UP PG_DN>;
        };

        win_layer_lower {
            bindings = <
&trans  &trans     &trans     &trans     &trans     &trans                       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans     &trans     &trans     &trans     &trans                       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans     &trans     &trans     &trans     &trans                       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(V)  &kp LC(B)  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                   &trans     &trans     &trans     &trans     &trans    &trans  &trans  &trans  &trans  &trans
            >;
        };

        mac_layer_lower {
            bindings = <
&trans  &trans     &trans     &trans     &trans     &trans                       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans     &trans     &trans     &trans     &trans                       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans     &trans     &trans     &trans     &trans                       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp LG(Z)  &kp LG(X)  &kp LG(C)  &kp LG(V)  &kp LG(B)  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                   &trans     &trans     &trans     &trans     &trans    &trans  &trans  &trans  &trans  &trans
            >;
        };

        win_raise_layer {
            display-name = "raise";

            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1  | BT2  |  BT3  |  BT4  |  BT5 |                |      |      |       |      |       |       |
            // |       | INS  | PSCR | GUI   |       |      |                | PGUP |      |   ^   |      |       |       |
            // |       | ALT  | CTRL | SHIFT |       | CAPS |                | PGDN |   <- |   v   |  ->  |  DEL  | BKSPC |
            // |       | UNDO | CUT  | COPY  | PASTE |      |      |  |      |      |      |       |      |       |       |
            //                |      |       |       |      |      |  |      |      |      |       |      |

            bindings = <
&bt BT_CLR  &bt BT_SEL 0                       &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3     &bt BT_SEL 4                         &trans      &trans     &trans    &trans     &bootloader    &studio_unlock
&trans      &kp C_AC_DESKTOP_SHOW_ALL_WINDOWS  &mkp MB4        &mmv MOVE_UP    &mkp MB5         &msc SCRL_UP                         &kp PG_UP   &mkp LCLK  &kp UP    &mkp RCLK  &mkp MCLK      &kp PRINTSCREEN
&trans      &none                              &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_DOWN                       &kp PG_DN   &kp LEFT   &kp DOWN  &kp RIGHT  &kp BACKSPACE  &kp DELETE
&trans      &trans                             &trans          &trans          &trans           &trans          &trans    &soft_off  &kp C_PREV  &trans     &trans    &trans     &none          &trans
                                               &trans          &trans          &trans           &trans          &trans    &trans     &trans      &trans     &trans    &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp PG_UP PG_DN>;
        };

        win_layer_raise {
            bindings = <
&trans  &trans     &trans     &trans     &trans     &trans                       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans     &trans     &trans     &trans     &trans                       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans     &trans     &trans     &trans     &trans                       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp LC(A)  &kp LC(S)  &kp LC(D)  &kp LC(F)  &kp LC(G)  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                   &trans     &trans     &trans     &trans     &trans    &trans  &trans  &trans  &trans  &trans
            >;
        };

        mac_layer_raise {
            bindings = <
&trans  &trans     &trans     &trans     &trans     &trans                       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans     &trans     &trans     &trans     &trans                       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans     &trans     &trans     &trans     &trans                       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp LG(A)  &kp LG(S)  &kp LG(D)  &kp LG(F)  &kp LG(G)  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                   &trans     &trans     &trans     &trans     &trans    &trans  &trans  &trans  &trans  &trans
            >;
        };

        set_layer {
            // ----------------------------------------------------------------------------------------------------------------------------
            // | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |      |       |      |       |       |
            // | EXTPWR | RGB_HUD | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |      |      |       |      |       |       |
            // |        | RGB_BRD | RGB_BRI |         |         |         |                  |      |      |       |      |       |       |
            // |        |         |         |         |         |         | RGB_TOG | |      |      |      |       |      |       |       |
            //                    |         |         |         |         |         | |      |      |      |       |      |

            display-name = "adjust";
            bindings = <
&clear_mods        &kb_win          &kb_mac          &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4                          &none  &none         &none         &none         &none   &none
&ext_power EP_TOG  &rgb_ug RGB_HUD  &rgb_ug RGB_HUI  &rgb_ug RGB_SAD  &rgb_ug RGB_SAI  &rgb_ug RGB_EFF                       &none  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &none   &none
&caps_word         &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &gresc           &none            &none                                 &none  &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp N0  &none
&none              &none            &none            &none            &none            &bootloader      &trans    &soft_off  &none  &kp N7        &kp N8        &kp N9        &none   &none
                                    &none            &none            &none            &none            &none     &none      &none  &none         &none         &none
            >;
        };
    };
};
