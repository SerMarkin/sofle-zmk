/* Pointing (mouse move / scroll): stock ZMK defaults are 600 / 10; values below override them. */
#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/modifiers.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/*
 * Layer indices (order in this keymap block):
 *  0 default_layer      4 win_layer_lower   (if-layers <3 1> -> 4)
 *  1 on_win             5 mac_layer_lower   (if-layers <3 2> -> 5)
 *  2 on_mac             6 win_raise_layer
 *  3 base_lower         7 set_layer (adjust; if-layers <3 6> -> 7)
 * &mo 3 = base_lower, &mo 6 = win_raise_layer, &mo 7 = set_layer (direct).
 */

/ {
    behaviors {
        /*
         * Ctrl+Tab -> Alt+Tab cycling (Windows task switcher):
         * &kp LA(TAB) releases Alt after each tap, so repeated Tab does not cycle.
         * Tri-state swapper: 1st tap toggles LALT on + Tab; further taps are Tab only;
         * interrupt toggles LALT off. timeout-ms ends the sequence if stuck.
         * ignored-key-positions: default_layer LEFT_SHIFT (24), LCTRL (36) so Shift+Tab / Ctrl do not end the sequence early.
         */
        win_alt_tab_swap: win_alt_tab_swap {
            compatible = "zmk,behavior-tri-state";
            #binding-cells = <0>;
            bindings = <&kt LALT>, <&kp TAB>, <&kt LALT>;
            ignored-key-positions = <24 36>;
            timeout-ms = <2000>;
        };

        tab_win_alt_tab: tab_win_alt_tab {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp TAB>, <&win_alt_tab_swap>;
            mods = <(MOD_LCTL)>;
        };
    };

    // Conditional layers: win/mac lower variants; lower (3) + raise (6) -> adjust (7).

    conditional_layers {
        compatible = "zmk,conditional-layers";

        // base_lower (3) + on_win (1) -> win_layer_lower (4)
        win_lower {
            if-layers = <3 1>;
            then-layer = <4>;
        };

        // base_lower (3) + on_mac (2) -> mac_layer_lower (5)
        mac_lower {
            if-layers = <3 2>;
            then-layer = <5>;
        };

        // base_lower (3) + win_raise_layer (6) -> set_layer (7)
        lower_raise_adjust {
            if-layers = <3 6>;
            then-layer = <7>;
        };
    };

    macros {
        // BT profile 0 + layer on_win (1)
        kb_win: kb_mod {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <15>;
            tap-ms = <15>;
            bindings = <&bt BT_SEL 0 &to 1>;
            label = "KB_MOD";
        };

        // BT profile 1 + layer on_mac (2)
        kb_mac: kb_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <15>;
            tap-ms = <15>;
            bindings = <&bt BT_SEL 1 &to 2>;
            label = "KB_MAC";
        };

        // Return to default layer (0)
        clear_mods: clear_mods {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0>;
            label = "CLEAR_MODS";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "default";

            // Row 0: ESC | 1-5 | 6-0 | MINUS
            // Row 1: Tab (LCtrl+Tab sends Alt+Tab) | Q-P | [
            // Row 2: Shift | A-L | ; '
            // Row 3: LCtrl | Z-B | mo ADJUST | C_MUTE | N-M | , . / | ]
            // Thumb: LAlt | Caps | LGUI | Lower | Space | Enter | Raise | Bspc | Del | RGUI

            bindings = <
&kp ESC         &kp N1  &kp N2        &kp N3    &kp N4    &kp N5                           &kp N6  &kp N7         &kp N8     &kp N9    &kp N0    &kp MINUS
&tab_win_alt_tab &kp Q   &kp W         &kp E     &kp R     &kp T                            &kp Y   &kp U          &kp I      &kp O     &kp P     &kp LEFT_BRACKET
&kp LEFT_SHIFT  &kp A   &kp S         &kp D     &kp F     &kp G                            &kp H   &kp J          &kp K      &kp L     &kp SEMI  &kp SQT
&kp LCTRL       &kp Z   &kp X         &kp C     &kp V     &kp B   &mo 7        &kp C_MUTE  &kp N   &kp M          &kp COMMA  &kp DOT   &kp FSLH  &kp RBKT
                        &kp LEFT_ALT  &kp CLCK  &kp LGUI  &mo 3   &kp SPACE    &kp RET     &mo 6   &kp BACKSPACE  &kp DEL    &kp RGUI
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp PG_UP PG_DN>;
        };

        // Windows-oriented modifiers on bottom row; other keys fall through to default_layer.
        on_win {
            bindings = <
&trans        &trans  &trans    &trans  &trans    &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans        &trans  &trans    &trans  &trans    &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans        &trans  &trans    &trans  &trans    &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&kp LEFT_ALT  &trans  &trans    &trans  &trans    &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                      &kp LWIN  &trans  &kp LCTRL &trans  &trans    &trans  &trans  &trans  &trans  &trans
            >;
        };

        // macOS-oriented modifiers on bottom row; other keys fall through to default_layer.
        on_mac {
            bindings = <
&trans     &trans  &trans    &trans  &trans        &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans     &trans  &trans    &trans  &trans        &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans     &trans  &trans    &trans  &trans        &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&kp LCTRL  &trans  &trans    &trans  &trans        &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                   &kp LALT  &trans  &kp LEFT_WIN  &trans  &trans    &trans  &trans  &trans  &trans  &trans
            >;
        };

        // Lower: F-keys row, symbols, numpad-style parens/plus on some keys (see bindings).
        base_lower {
            display-name = "lower";
            bindings = <
&trans   &kp F1     &kp F2             &kp F3     &kp F4         &kp F5                       &kp F6        &kp F7      &kp F8     &kp F9                   &kp F10                   &kp F11
&kp DEL  &kp EXCL   &kp AT_SIGN        &kp POUND  &kp DOLLAR     &kp PRCNT                    &kp CARET     &kp AMPS    &kp STAR   &kp LPAR  &kp RPAR  &kp F12
&trans   &kp GRAVE  &kp DOUBLE_QUOTES  &kp POUND  &kp SEMICOLON  &kp EQUAL                    &kp KP_PLUS   &kp QMARK   &kp PIPE   &kp LBRC                 &kp RBRC                  &kp PIPE
&trans   &trans     &trans             &trans     &trans         &trans     &trans    &trans  &kp KP_COMMA  &kp KP_DOT  &kp COMMA  &kp LBKT                 &kp RBKT                  &kp BSLH
                    &trans             &trans     &trans         &trans     &trans    &trans  &trans        &trans      &trans     &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp PG_UP PG_DN>;
        };

        // Shown when lower (3) + on_win (1): Ctrl+Z/X/C/V/B undo/cut/copy/paste; A = select all.
        win_layer_lower {
            bindings = <
&trans  &trans     &trans     &trans     &trans     &trans                       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans     &trans     &trans     &trans     &trans                       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp LC(A)  &trans     &trans     &trans     &trans                       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(V)  &kp LC(B)  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                   &trans     &trans     &trans     &trans     &trans    &trans  &trans  &trans  &trans  &trans
            >;
        };

        // Shown when lower (3) + on_mac (2): Cmd+Z/X/C/V/B; A = select all.
        mac_layer_lower {
            bindings = <
&trans  &trans     &trans     &trans     &trans     &trans                       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans     &trans     &trans     &trans     &trans                       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp LG(A)  &trans     &trans     &trans     &trans                       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp LG(Z)  &kp LG(X)  &kp LG(C)  &kp LG(V)  &kp LG(B)  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                   &trans     &trans     &trans     &trans     &trans    &trans  &trans  &trans  &trans  &trans
            >;
        };

        win_raise_layer {
            display-name = "raise";

            // Row 0: BT_CLR, BT_SEL 0-4, trans x3, bootloader, studio_unlock
            // Row 1: trans, Mission Control, mouse / pointer / scroll, PgUp, clicks, arrows, PrtSc
            // Row 2: trans, none, pointer move + scroll, PgDn, arrows, Bspc, Del
            // Row 3: trans; soft_off; C_PREV; inner keys trans/none

            bindings = <
&bt BT_CLR  &bt BT_SEL 0                       &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3     &bt BT_SEL 4                         &trans      &trans     &trans    &trans     &bootloader    &studio_unlock
&trans      &kp C_AC_DESKTOP_SHOW_ALL_WINDOWS  &mkp MB4        &mmv MOVE_UP    &mkp MB5         &msc SCRL_UP                         &kp PG_UP   &mkp LCLK  &kp UP    &mkp RCLK  &mkp MCLK      &kp PRINTSCREEN
&trans      &none                              &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_DOWN                       &kp PG_DN   &kp LEFT   &kp DOWN  &kp RIGHT  &kp BACKSPACE  &kp DELETE
&trans      &trans                             &trans          &trans          &trans           &trans          &trans    &soft_off  &kp C_PREV  &trans     &trans    &trans     &none          &trans
                                               &trans          &trans          &trans           &trans          &trans    &trans     &trans      &trans     &trans    &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp PG_UP PG_DN>;
        };

        set_layer {
            // Adjust: clear + kb_win/kb_mac + BT 2-4 | ext power + RGB | RGB brightness | bootloader / soft off
            display-name = "adjust";
            bindings = <
&clear_mods        &kb_win          &kb_mac          &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4                          &none  &none  &none  &none  &none  &none
&ext_power EP_TOG  &rgb_ug RGB_HUD  &rgb_ug RGB_HUI  &rgb_ug RGB_SAD  &rgb_ug RGB_SAI  &rgb_ug RGB_EFF                       &none  &none  &none  &none  &none  &none
&none              &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &none            &none            &none                                 &none  &none  &none  &none  &none  &none
&none              &none            &none            &none            &none            &bootloader      &trans    &soft_off  &none  &none  &none  &none  &none  &none
                                    &none            &none            &none            &none            &none     &none      &none  &none  &none  &none
            >;
        };
    };
};
